NODE_ENV=development
PORT=3000

# Dev DB (PostgreSQL - usada cuando NODE_ENV != "production")
DEV_DIALECT=postgres
DEV_HOST=localhost
DEV_PORT=5432
DEV_USERNAME=postgres
DEV_PASSWORD=secret
DEV_DB=odata_dev

# Prod DB
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB=odata_prod

# JWT Secret (OBLIGATORIA en producción, >= 32 chars; el server aborta si es débil)
SECRET_KEY=your-secret-key-here

# CORS (OBLIGATORIA en producción: origen exacto permitido, p.ej. https://demo.example.com)
CORS_ORIGIN=http://localhost:5173

# Conexion/BD (ciclo 17 F3; defaults prudentes si se omiten)
DB_STATEMENT_TIMEOUT=30000          # ms; query mas lenta de una sentencia (0 = sin limite)
DB_POOL_MAX=10                      # conexiones maximas del pool
DB_POOL_MIN=2                       # conexiones minimas del pool
DB_SSL_REJECT_UNAUTHORIZED=true     # false solo si la BD usa cert self-signed (p.ej. RDS/CloudSQL)
